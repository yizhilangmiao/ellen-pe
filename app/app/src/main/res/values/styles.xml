<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/ellen_bg</item>
        <item name="android:statusBarColor">@color/ellen_bg</item>
        <item name="android:navigationBarColor">@color/ellen_bg</item>
        <item name="android:alertDialogTheme">@style/EllenAlertDialog</item>
        <item name="alertDialogTheme">@style/EllenAlertDialog</item>
    </style>

    <style name="EllenAlertDialog" parent="Theme.AppCompat.Dialog.Alert">
        <item name="android:background">@color/ellen_dialog_bg</item>
        <item name="android:textColorPrimary">@color/ellen_dialog_text</item>
        <item name="android:textColorSecondary">@color/ellen_dialog_muted</item>
        <item name="colorAccent">@color/ellen_pink</item>
    </style>
</resources>
