# 艾莲手机版 · 创作版仓库忽略规则（仓库根 = 该目录）
# 收什么：能动手改的源码 —— _phone-sync\（旧包注入层）、app\（新壳 Gradle + Vite 源码）、
#         _patch_phone_*.py、_dev_*、契约与验收文档。
# 不收：可再生产物、二进制大件、旧包解包基线。

# ── 新壳构建产物 ──
/app/app/build/
/app/build/
/app/.gradle/
/app/.kotlin/
/app/web/node_modules/
/app/web/dist/
/app/app/src/main/assets/public/
*.apk
*.idsig
*.aab

# ── 二进制大件（可重新下载，见 _verify 文档里的地址）──
/app/app/libs/*.aar
/app/app/src/main/assets/asr/
/app/app/src/main/assets/local-asr/
_downloads/
_下载/

# ── 旧包解包基线（780 MB，_dev_extract.py 可重建）──
/work/
/work_*/
/dexwork/
/dexcheck/
/package/
/web/
/web_out/
/web_out.bak*/
/dup/
/dup_*/
/web_out.bak_uuid/

# ── 打包与临时 ──
/_build/
/_临时/
/esbuild.tgz
/test-main.js
__pycache__/
*.pyc
*.log
*.bak
*.bak-*
*.zip
*.7z
Thumbs.db
desktop.ini

# ── 备份快照 ──
/_backup_mem/
/_b12/
